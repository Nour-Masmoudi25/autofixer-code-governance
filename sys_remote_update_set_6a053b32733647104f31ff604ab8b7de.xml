<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update table="sys_script_include"&gt;&lt;sys_script_include action="INSERT_OR_UPDATE"&gt;&lt;access&gt;public&lt;/access&gt;&lt;active&gt;true&lt;/active&gt;&lt;api_name&gt;global.CodeAutoFixerEngine&lt;/api_name&gt;&lt;caller_access/&gt;&lt;client_callable&gt;false&lt;/client_callable&gt;&lt;description/&gt;&lt;mobile_callable&gt;false&lt;/mobile_callable&gt;&lt;name&gt;CodeAutoFixerEngine&lt;/name&gt;&lt;sandbox_callable&gt;false&lt;/sandbox_callable&gt;&lt;script&gt;&lt;![CDATA[var CodeAutoFixerEngine = Class.create();
CodeAutoFixerEngine.prototype = {
    initialize: function() {
		this.companyPrefix = "DEV: ";
		this.logTable = "x_2107891_autofi_0_autofixer_log";

		this.rules = [
			{
				id: 'naming_standard_pending',
				detect: this.detectNamingStandardIssue,
				fix: function(gr, proposedValue) {
					gr.setValue('name', proposedValue);
				}
			},
			{
				id: 'documentation_pending',
				detect: this.detectDocumentationIssue,
				fix: function(gr, proposedValue) {
					gr.setValue('script', proposedValue);
				}
			},
			{
				id: 'bad_gr_variable_pending',
				detect: this.checkGlobalGRVariable,
				fix: null
			},
			{
				id: 'eval_usage_pending',
				detect: this.checkEval,
				fix: null
			},
			{
				id: 'gslog_usage_pending',
				detect: this.checkGSLog,
				fix: null
			},
			{
				id: 'new_array_pending',
				detect: this.checkNewArray,
				fix: null
			},
			{
				id: 'new_object_pending',
				detect: this.checkNewObject,
				fix: null
			},
			{
				id: 'gssleep_pending',
				detect: this.checkGSSleep,
				fix: null
			},
			{
				id: 'getxml_pending',
				detect: this.checkGetXML,
				fix: null
			},
			{
				id: 'getreference_pending',
				detect: this.checkGetReference,
				fix: null
			},
			{
				id: 'hardcoded_sysid_pending',
				detect: this.checkHardcodedSysId,
				fix: null
			},
			{
				id: 'hardcoded_url_pending',
				detect: this.checkHardcodedUrl,
				fix: null
			},
			{
				id: 'setbasicauth_pending',
				detect: this.checkSetBasicAuth,
				fix: null
			},
			{
				id: 'global_client_script_pending',
				detect: this.checkGlobalClientScript,
				fix: null
			},
			{
				id: 'global_business_rule_pending',
				detect: this.checkGlobalBusinessRule,
				fix: null
			}
		];
	},

    processUpdateSet: function(updateSetId) {

		if (!updateSetId)
			return;

		this.detectSystemJunk(updateSetId);

		var grUpdateXML = new GlideRecord('sys_update_xml');
		grUpdateXML.addQuery('update_set', updateSetId);
		grUpdateXML.addQuery('name', 'STARTSWITH', 'sys_script')
			.addOrCondition('name', 'STARTSWITH', 'sys_script_include')
			.addOrCondition('name', 'STARTSWITH', 'sys_script_client');
		grUpdateXML.query();

		while (grUpdateXML.next()) {

			var xmlName = grUpdateXML.getValue('name');
			var typeName = grUpdateXML.getValue('type') || "Script Component";

			if (!xmlName || xmlName.length &lt;= 33)
				continue;

			var targetSysId = xmlName.substring(xmlName.length - 32);
			var targetTable = xmlName.substring(0, xmlName.length - 33);

			var grSource = new GlideRecord(targetTable);

			if (!grSource.isValid() || !grSource.get(targetSysId))
				continue;

			var srcName = grSource.getValue('name') || '';

			if (srcName.indexOf('AutoFixer') &gt; -1 || srcName.indexOf('CodeAutoFixer') &gt; -1)
				continue;

			for (var i = 0; i &lt; this.rules.length; i++) {

				var rule = this.rules[i];

				var result = rule.detect.call(this, grSource);

				if (!result)
					continue;

				this._createLog({

					updateSet: updateSetId,

					element: typeName + ": " + (grSource.getValue('name') || ''),

					actionType: rule.id,

					details: result.details,

					targetTable: grSource.getTableName(),

					targetSysId: grSource.getUniqueValue(),

					currentValue: result.currentValue || '',

					proposedValue: result.proposedValue || '',

					lineNumber: result.lineNumber || null,

					auditHistory: this.formatAuditHistory(
						grSource.getTableName(),
						grSource.getUniqueValue()
					)

				});

			}

		}

		this.runNativePreview(updateSetId);
		this.readPreviewProblems(updateSetId);

	},

    detectSystemJunk: function(updateSetId) {
        var grJunk = new GlideRecord('sys_update_xml');
        grJunk.addQuery('update_set', updateSetId);
        grJunk.addQuery('sys_created_by', 'system');
        grJunk.query();

        while (grJunk.next()) {
            var recordName = grJunk.getValue('target_name') || grJunk.getValue('name');
            var recordType = grJunk.getValue('type') || 'System Record';

            this._createLog({
                updateSet: updateSetId,
                element: recordType + ": " + recordName,
                actionType: 'junk_pending',
                details: "System-generated change detected (created by 'system'). Likely background noise (scheduled job, property auto-update) rather than real development work.",
                targetTable: 'sys_update_xml',
                targetSysId: grJunk.getUniqueValue(),
                currentValue: 'Present in update set',
                proposedValue: 'Removed from update set'
            });
        }
    },

	detectNamingStandardIssue: function(grRecord) {
		if (!grRecord.isValidField('name')) return null;
		var currentName = grRecord.getValue('name') || "";
		if (!currentName) return null;

		if (currentName.startsWith(this.companyPrefix)) {
			var rest = currentName.substring(this.companyPrefix.length);
			var cleanRest = rest.replace(/\s+/g, '');
			if (cleanRest === rest) return null;
			var fixedName = this.companyPrefix + cleanRest;
			return {
				details: "Naming standard issue detected. Extra spaces removed after the prefix.",
				currentValue: currentName,
				proposedValue: fixedName
			};
		}

		var cleanName = currentName.replace(/\s+/g, '');
		var finalName = this.companyPrefix + cleanName;

		return {
			details: "Naming standard issue detected. Spaces removed and company prefix added.",
			currentValue: currentName,
			proposedValue: finalName
		};
	},

    detectDocumentationIssue: function(grRecord) {

		if (!grRecord.isValidField('script'))
			return null;

		var script = grRecord.getValue('script') || "";

		var description = "";

		if (grRecord.isValidField('description'))
			description = grRecord.getValue('description') || "";

		var hasHeader =
			script.trim().indexOf("/**") === 0;

		if (description || hasHeader)
			return null;

		var recordName = grRecord.getValue('name') || "";

		var today = new GlideDateTime()
			.getLocalDate()
			.getDisplayValue();

		var regex = /(\w+)\s*:\s*function\s*\(([^)]*)\)/g;

		var methods = [];

		var match;

		while ((match = regex.exec(script)) !== null) {

			var method = match[1];

			var params = match[2].trim();

			methods.push(" * - " + method + "(" + params + ")");

		}

		var header =
			"/**\n" +
			" * @name " + recordName + "\n" +
			" * @description TODO: Describe the purpose of this Script Include.\n" +
			" * @date " + today + "\n" +
			" * @methods\n";

		if (methods.length &gt; 0)
			header += methods.join("\n") + "\n";
		else
			header += " * - No methods detected\n";

		header += " */\n\n";

		return {

			details:
				"Documentation header missing. Proposed header contains " +
				methods.length +
				" detected method(s).",

			currentValue: script,

			proposedValue: header + script

		};

	},
    // Calcule le numéro de ligne à partir de l'index d'un match trouvé dans le script
    getLineNumber: function(script, matchIndex) {
        if (matchIndex === undefined || matchIndex === null || matchIndex &lt; 0) return null;
        return script.substring(0, matchIndex).split('\n').length;
    },

	checkGlobalGRVariable: function(grRecord) {

		if (!grRecord.isValidField('script'))
			return null;

		var script = grRecord.getValue('script') || "";

		var regex = /\b(var|let)\s+gr\b/;
		var match = regex.exec(script);

		if (!match)
			return null;

		return {
			details: "Variable name 'gr' detected. Use descriptive GlideRecord variable names instead.",
			currentValue: "Variable 'gr' found in script.",
			proposedValue: "Rename variable to a descriptive name.",
			lineNumber: this.getLineNumber(script, match.index)
		};
	},

	checkGSLog: function(gr) {

		if (!gr.isValidField('script'))
			return null;

		var script = gr.getValue('script') || '';
		var match = /gs\.log\s*\(/.exec(script);

		if (match) {
			return {
				details: "Usage of gs.log() detected. Prefer gs.info(), gs.warn() or gs.error().",
				currentValue: "gs.log() found in script",
				proposedValue: "",
				lineNumber: this.getLineNumber(script, match.index)
			};
		}

		return null;
	},

	checkEval: function(gr) {

		if (!gr.isValidField('script'))
			return null;

		var script = gr.getValue('script') || '';
		var match = /\beval\s*\(/.exec(script);

		if (match) {
			return {
				details: "Usage of eval() detected. Improper use of eval() opens your code to injection attacks.",
				currentValue: "eval() found in script",
				proposedValue: "",
				lineNumber: this.getLineNumber(script, match.index)
			};
		}

		return null;
	},

	checkNewArray: function(gr) {
		if (!gr.isValidField('script')) return null;
		var script = gr.getValue('script') || '';
		var match = /new\s+Array\s*\(/.exec(script);
		if (match) {
			return {
				details: "Usage of 'new Array()' detected. Prefer the literal notation [].",
				currentValue: "new Array() found in script",
				proposedValue: "",
				lineNumber: this.getLineNumber(script, match.index)
			};
		}
		return null;
	},

	checkNewObject: function(gr) {
		if (!gr.isValidField('script')) return null;
		var script = gr.getValue('script') || '';
		var match = /new\s+Object\s*\(/.exec(script);
		if (match) {
			return {
				details: "Usage of 'new Object()' detected. Prefer the literal notation {}.",
				currentValue: "new Object() found in script",
				proposedValue: "",
				lineNumber: this.getLineNumber(script, match.index)
			};
		}
		return null;
	},

	checkGSSleep: function(gr) {
		if (!gr.isValidField('script')) return null;
		var script = gr.getValue('script') || '';
		var match = /gs\.sleep\s*\(/.exec(script);
		if (match) {
			return {
				details: "Usage of gs.sleep() detected on the server side. Blocks the thread and degrades platform performance.",
				currentValue: "gs.sleep() found in script",
				proposedValue: "",
				lineNumber: this.getLineNumber(script, match.index)
			};
		}
		return null;
	},

	checkGetXML: function(gr) {
		if (!gr.isValidField('script')) return null;
		var script = gr.getValue('script') || '';
		var match = /\.getXML\s*\(/.exec(script);
		if (match &amp;&amp; !/\.getXMLAnswer\s*\(/.test(script)) {
			return {
				details: "Usage of getXML() detected. Prefer getXMLAnswer(), more reliable for parsing the response.",
				currentValue: "getXML() found in script",
				proposedValue: "",
				lineNumber: this.getLineNumber(script, match.index)
			};
		}
		return null;
	},

	checkGetReference: function(gr) {
		if (!gr.isValidField('script')) return null;
		var script = gr.getValue('script') || '';
		var match = /\.getReference\s*\(/.exec(script);
		if (match) {
			return {
				details: "Usage of getReference() detected. Synchronous and expensive, prefer a direct GlideRecord query.",
				currentValue: "getReference() found in script",
				proposedValue: "",
				lineNumber: this.getLineNumber(script, match.index)
			};
		}
		return null;
	},

	checkHardcodedSysId: function(gr) {
		if (!gr.isValidField('script')) return null;
		var script = gr.getValue('script') || '';
		var pattern = /("|'|=|h|H|n|N|f|F|,)[a-z0-9]{32}("|'|\^|,|@)/;
		var match = pattern.exec(script);
		if (match) {
			return {
				details: "Hardcoded sys_id detected in the script — breaks portability between environments.",
				currentValue: "Hardcoded sys_id found",
				proposedValue: "",
				lineNumber: this.getLineNumber(script, match.index)
			};
		}
		return null;
	},

	checkHardcodedUrl: function(gr) {
		if (!gr.isValidField('script')) return null;
		var script = gr.getValue('script') || '';
		var instanceName = gs.getProperty('instance_name');
		if (instanceName) {
			var idx = script.indexOf(instanceName);
			if (idx &gt; -1) {
				return {
					details: "Hardcoded instance URL/name detected — breaks portability between environments (dev/test/prod).",
					currentValue: "Hardcoded instance URL found",
					proposedValue: "",
					lineNumber: this.getLineNumber(script, idx)
				};
			}
		}
		return null;
	},

	checkSetBasicAuth: function(gr) {
		if (!gr.isValidField('script')) return null;
		var script = gr.getValue('script') || '';
		var match = /\.setBasicAuth\s*\(/.exec(script);
		if (match) {
			return {
				details: "Usage of setBasicAuth() detected. Prefer a managed authentication profile instead of hardcoded credentials.",
				currentValue: "setBasicAuth() found in script",
				proposedValue: "",
				lineNumber: this.getLineNumber(script, match.index)
			};
		}
		return null;
	},

	checkGlobalClientScript: function(gr) {
		if (gr.getTableName() !== 'sys_script_client') return null;
		if (gr.getValue('table') === 'global' &amp;&amp; gr.active == true) {
			return {
				details: "Global Client Script detected — runs on ALL tables, high potential performance impact.",
				currentValue: "Global Client Script active",
				proposedValue: ""
			};
		}
		return null;
	},

	checkGlobalBusinessRule: function(gr) {
		if (gr.getTableName() !== 'sys_script') return null;
		if (gr.getValue('collection') === 'global' &amp;&amp; gr.active == true) {
			return {
				details: "Global Business Rule detected — prefer a Script Include explicitly called rather than execution on all tables.",
				currentValue: "Global Business Rule active",
				proposedValue: ""
			};
		}
		return null;
	},

    runNativePreview: function(updateSetId) {
        var worker = new GlideUpdateSetWorker();
        worker.setUpdateSetID(updateSetId);
        worker.setBackground(false);
        worker.start();
        worker.waitForCompletion();
    },

    readPreviewProblems: function(updateSetId) {
        var grProblems = new GlideRecord('sys_update_preview_problem');
        grProblems.addQuery('update_set', updateSetId);
        grProblems.query();
        while (grProblems.next()) {
            this._createLog({
                updateSet: updateSetId,
                element: grProblems.getValue('name') || 'Update Set Problem',
                actionType: 'conflict_detected',
                details: grProblems.getValue('description') || grProblems.getValue('short_description') || 'Native ServiceNow preview problem detected.',
                currentValue: '',
                proposedValue: ''
            });
        }
    },

    applyFix: function(logSysId) {
		var grLog = new GlideRecord(this.logTable);
		if (!grLog.get(logSysId)) return false;
		if (grLog.getValue('status') != 'pending') return false;

		var actionType = grLog.getValue('action_type');
		var targetTable = grLog.getValue('target_table');
		var targetSysId = grLog.getValue('target_sys_id');
		var updateSucceeded = true;

		var rule = null;
		for (var i = 0; i &lt; this.rules.length; i++) {
			if (this.rules[i].id === actionType) { rule = this.rules[i]; break; }
		}

		if (rule &amp;&amp; rule.fix &amp;&amp; targetTable &amp;&amp; targetSysId) {
			var grTarget = new GlideRecord(targetTable);
			if (grTarget.get(targetSysId)) {
				rule.fix(grTarget, grLog.getValue('proposed_value'));
				var result = grTarget.update();
				if (!result) updateSucceeded = false;
			} else {
				updateSucceeded = false;
			}
		} else if (actionType == 'junk_pending' &amp;&amp; targetSysId) {
			var grXml = new GlideRecord('sys_update_xml');
			if (grXml.get(targetSysId)) {
				updateSucceeded = grXml.deleteRecord();
			}
		}

		grLog.setValue('status', updateSucceeded ? 'applied' : 'failed');
		grLog.update();
		return updateSucceeded;
	},

    rejectFix: function(logSysId) {
        var grLog = new GlideRecord(this.logTable);
        if (grLog.get(logSysId)) {
            grLog.setValue('status', 'rejected');
            grLog.update();
        }
        return true;
    },

    formatAuditHistory: function(targetTable, targetSysId) {
        var lines = [];
        var grAudit = new GlideRecord('sys_audit');
        grAudit.addQuery('tablename', targetTable);
        grAudit.addQuery('documentkey', targetSysId);
        grAudit.orderByDesc('sys_created_on');
        grAudit.setLimit(5);
        grAudit.query();
        while (grAudit.next()) {
            lines.push(
                grAudit.getValue('sys_created_on') + ' — ' +
                grAudit.getDisplayValue('user') + ' changed ' +
                grAudit.getValue('fieldname') + ': "' +
                grAudit.getValue('oldvalue') + '" → "' +
                grAudit.getValue('newvalue') + '"'
            );
        }
        return lines.length ? lines.join('\n') : 'No recorded change history for this record.';
    },

    _createLog: function(logData) {
        var grLog = new GlideRecord(this.logTable);
        grLog.initialize();
        grLog.setValue('update_set', logData.updateSet);
        grLog.setValue('corrected_element', logData.element);
        grLog.setValue('action_type', logData.actionType);
        grLog.setValue('previous_name', logData.previousName || '');
        grLog.setValue('new_name', logData.newName || '');
        grLog.setValue('details', logData.details);
        grLog.setValue('target_table', logData.targetTable || '');
        grLog.setValue('target_sys_id', logData.targetSysId || '');
        grLog.setValue('current_value', logData.currentValue || '');
        grLog.setValue('proposed_value', logData.proposedValue || '');
        grLog.setValue('audit_history', logData.auditHistory || '');
        if (logData.lineNumber) grLog.setValue('line_number', logData.lineNumber);
        grLog.setValue('status', 'pending');
        grLog.insert();
    },

    type: 'CodeAutoFixerEngine'
};]]&gt;&lt;/script&gt;&lt;sys_class_name&gt;sys_script_include&lt;/sys_class_name&gt;&lt;sys_created_by&gt;admin&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2026-07-21 20:54:58&lt;/sys_created_on&gt;&lt;sys_id&gt;1952ab14731e8b504f31ff604ab8b78a&lt;/sys_id&gt;&lt;sys_mod_count&gt;17&lt;/sys_mod_count&gt;&lt;sys_name&gt;CodeAutoFixerEngine&lt;/sys_name&gt;&lt;sys_package display_value="Global" source="global"&gt;global&lt;/sys_package&gt;&lt;sys_policy/&gt;&lt;sys_scope display_value="Global"&gt;global&lt;/sys_scope&gt;&lt;sys_update_name&gt;sys_script_include_1952ab14731e8b504f31ff604ab8b78a&lt;/sys_update_name&gt;&lt;sys_updated_by&gt;admin&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2026-08-23 12:50:16&lt;/sys_updated_on&gt;&lt;/sys_script_include&gt;&lt;sys_es_latest_script action="INSERT_OR_UPDATE"&gt;&lt;id&gt;1952ab14731e8b504f31ff604ab8b78a&lt;/id&gt;&lt;sys_created_by&gt;admin&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2026-07-21 20:54:57&lt;/sys_created_on&gt;&lt;sys_id&gt;0b85af18731e8b504f31ff604ab8b761&lt;/sys_id&gt;&lt;sys_mod_count&gt;0&lt;/sys_mod_count&gt;&lt;sys_updated_by&gt;admin&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2026-07-21 20:54:57&lt;/sys_updated_on&gt;&lt;table&gt;sys_script_include&lt;/table&gt;&lt;use_es_latest&gt;true&lt;/use_es_latest&gt;&lt;/sys_es_latest_script&gt;&lt;/record_update&gt;</payload>
