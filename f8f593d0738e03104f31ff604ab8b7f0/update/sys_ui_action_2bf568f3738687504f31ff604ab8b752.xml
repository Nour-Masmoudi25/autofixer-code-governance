        <script><![CDATA[function confirmApplyFix() {
    if (confirm('Apply this fix? This will modify the real record in the target table.')) {
        var actionType = g_form.getValue('action_type');
        var MANUAL_FIX_TYPES = ['bad_gr_variable_pending', 'eval_usage_pending', 'gslog_usage_pending', 'new_array_pending', 'new_object_pending', 'gssleep_pending', 'getxml_pending', 'getreference_pending', 'hardcoded_sysid_pending', 'hardcoded_url_pending', 'setbasicauth_pending'];

        if (MANUAL_FIX_TYPES.indexOf(actionType) > -1) {
            var targetTable = g_form.getValue('target_table');
            var targetSysId = g_form.getValue('target_sys_id');
            if (targetTable && targetSysId) {
                var fullUrl = top.location.origin + '/' + targetTable + '.do?sys_id=' + targetSysId;
                top.open(fullUrl, '_blank');
            }
        }

        gsftSubmit(null, g_form.getFormElement(), 'apply_fix');
    }
}]]></script>
