<?xml version="1.0" encoding="UTF-8"?><record_update table="sys_ui_page">
    <sys_ui_page action="INSERT_OR_UPDATE">
        <category>general</category>
        <client_script/>
        <description/>
        <direct>false</direct>
        <endpoint>x_2107891_autofi_0_autofixer_review.do</endpoint>
        <html><![CDATA[<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide">
<div style="font-family:Arial, sans-serif; max-width:720px; margin:24px auto;">

  <div style="font-size:12px; color:#888; margin-bottom:6px;">Update set: ${jvar_update_set}</div>

  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
    <h2 style="margin:0; font-size:19px; color:#1a1a2e;">${jvar_element}</h2>
    <span style="padding:4px 12px; border-radius:12px; font-size:12px; font-weight:bold;
      background-color: ${jvar_status == 'pending' ? '#FFF3CD' : (jvar_status == 'applied' ? '#D4EDDA' : '#F8D7DA')};
      color: ${jvar_status == 'pending' ? '#856404' : (jvar_status == 'applied' ? '#155724' : '#721C24')};">
      ${jvar_status}
    </span>
  </div>

  <div style="background:#f8f9fa; border-left:4px solid #6c63ff; padding:12px 16px; border-radius:4px; margin-bottom:20px; font-size:14px; color:#333;">
    ${jvar_details}
  </div>

  <j:if test="${jvar_current_value != '' || jvar_proposed_value != ''}">
  <div style="display:flex; gap:16px; margin-bottom:24px;">
    <div style="flex:1; background:#fdecea; border:1px solid #f5c6cb; border-radius:6px; padding:12px;">
      <div style="font-size:11px; text-transform:uppercase; color:#a94442; font-weight:bold; margin-bottom:6px;">Current</div>
      <pre style="white-space:pre-wrap; word-break:break-word; font-family:monospace; font-size:13px; margin:0; color:#5a1a1a;">${jvar_current_value}</pre>
    </div>
    <div style="flex:1; background:#eafaf1; border:1px solid #b7e4c7; border-radius:6px; padding:12px;">
      <div style="font-size:11px; text-transform:uppercase; color:#1e7e34; font-weight:bold; margin-bottom:6px;">Proposed</div>
      <pre style="white-space:pre-wrap; word-break:break-word; font-family:monospace; font-size:13px; margin:0; color:#0f3d1e;">${jvar_proposed_value}</pre>
    </div>
  </div>
  </j:if>

  <div id="autofixer-msg" style="display:none; margin-bottom:12px; padding:10px; border-radius:4px; font-size:13px;"></div>

  <div style="display:flex; gap:10px;">
    <j:if test="${jvar_status == 'pending'}">
      <button type="button" onclick="applyFix()" style="background:#28a745; color:#fff; border:none; padding:10px 18px; border-radius:4px; cursor:pointer; font-size:14px;">Apply fix</button>
      <button type="button" onclick="rejectFix()" style="background:#dc3545; color:#fff; border:none; padding:10px 18px; border-radius:4px; cursor:pointer; font-size:14px;">Reject</button>
    </j:if>
    <button type="button" onclick="history.back()" style="background:#e9ecef; color:#333; border:none; padding:10px 18px; border-radius:4px; cursor:pointer; font-size:14px;">Back</button>
  </div>
</div>

<script>
function applyFix() { callAjax('applyFix', 'Fix applied successfully.', 'Could not apply fix.'); }
function rejectFix() { callAjax('rejectFix', 'Finding rejected.', 'Could not reject finding.'); }

function callAjax(method, okMsg, errMsg) {
    var ga = new GlideAjax('CodeAutoFixerAjax');
    ga.addParam('sysparm_name', method);
    ga.addParam('sysparm_log_id', '${jvar_log_id}');
    ga.getXML(function(response) {
        var result = response.responseXML.documentElement.getAttribute('answer');
        var el = document.getElementById('autofixer-msg');
        el.style.display = 'block';
        var ok = (result === 'success');
        el.style.background = ok ? '#d4edda' : '#f8d7da';
        el.style.color = ok ? '#155724' : '#721c24';
        el.innerText = ok ? okMsg : errMsg;
        if (ok) setTimeout(function(){ window.location.reload(); }, 900);
    });
}
</script>
</j:jelly>]]></html>
        <name>autofixer_review</name>
        <processing_script><![CDATA[var logId = RP.getParameterValue('sysparm_log_id');
var gr = new GlideRecord('x_2107891_autofi_0_autofixer_log');
if (gr.get(logId)) {
    jvar_log_id = gr.getUniqueValue();
    jvar_element = gr.getValue('corrected_element');
    jvar_action_type = gr.getDisplayValue('action_type');
    jvar_status = gr.getValue('status');
    jvar_details = gr.getValue('details');
    jvar_current_value = gr.getValue('current_value');
    jvar_proposed_value = gr.getValue('proposed_value');
    jvar_update_set = gr.update_set.getDisplayValue();
}]]></processing_script>
